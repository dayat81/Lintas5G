# srsUE 5G SA (ZMQ), pair __I__. Rendered to /etc/lab5g/sa/pair__I__/ue.conf (0600): subscriber secrets.
[rf]
freq_offset = 0
tx_gain = 50
rx_gain = 40
srate = __SR__e6
nof_antennas = 1
device_name = zmq
device_args = tx_port=tcp://127.0.0.1:__RXP__,rx_port=tcp://127.0.0.1:__TXP__,base_srate=__SR__e6

[rat.eutra]
dl_earfcn = 2850
nof_carriers = 0

[rat.nr]
bands = 3
nof_carriers = 1
max_nof_prb = __PRB__
nof_prb = __PRB__

[pcap]
enable = none

[log]
all_level = warning
filename = /var/log/lab5g/sa/ue__I__.log

[usim]
mode = soft
algo = milenage
opc  = __OPC__
k    = __K__
imsi = __IMSI__
imei = __IMEI__

[rrc]
release = 15
ue_category = 4

[nas]
apn = internet
apn_protocol = ipv4

[gw]
netns = ue__I__
ip_devname = __IFNAME__
ip_netmask = 255.255.0.0

[gui]
enable = false
