# srsUE 5G SA (ZMQ), lab5g. Rendered to /etc/lab5g/sa/ue.conf (0600): contains subscriber secrets.
[rf]
freq_offset = 0
tx_gain = 50
rx_gain = 40
srate = __SR__e6
nof_antennas = 1
device_name = zmq
device_args = tx_port=tcp://127.0.0.1:2001,rx_port=tcp://127.0.0.1:2000,base_srate=__SR__e6

[rat.eutra]
dl_earfcn = 2850
nof_carriers = 0

[rat.nr]
bands = 3
nof_carriers = 1
max_nof_prb = __PRB__
nof_prb = __PRB__

[pcap]
enable = none

[log]
all_level = warning
filename = /var/log/lab5g/sa/ue.log

[usim]
mode = soft
algo = milenage
opc  = __OPC__
k    = __K__
imsi = __IMSI__
imei = 353490069873319

[rrc]
release = 15
ue_category = 4

[nas]
apn = internet
apn_protocol = ipv4

[gw]
netns = ue1
ip_devname = tun_srsue
ip_netmask = 255.255.0.0

[gui]
enable = false
