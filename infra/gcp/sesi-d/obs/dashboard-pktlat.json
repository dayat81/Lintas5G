  "panels": [
    {
      "id": 1,
      "title": "Per-packet one-way UL (ms): p50/p99 per kondisi x segmen (radio = UE->N3, core = N3->N6, total = UE->N6)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ch"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(cond,' / ',seg) AS kondisi, p50, p99 FROM poc_latency.v_pkt_q WHERE session = '${session}' AND dir='UL' AND cond != 'other' ORDER BY seg, indexOf(['idle','load','load+qod'], cond)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "xField": "kondisi",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
