# Salin ke terraform.tfvars (file itu tidak ikut di-commit jika berisi identitas nyata).
# Jangan isi kredensial, kunci, atau token di file ini.

project_id = "YOUR_PROJECT_ID"
region     = "asia-southeast2"
zone       = "asia-southeast2-a"

# true = vm-emu Spot (lebih murah, bisa di-preempt). Di project uji 17 Nov 2026,
# kuota PREEMPTIBLE_CPUS asia-southeast2 = 0, jadi Spot tidak bisa dipakai sampai kuota naik.
emu_spot = false

# Anggota IAM yang boleh SSH/VNC/Grafana lewat IAP + OS Login.
# Tambahkan service account operator jika apply/SSH dijalankan sebagai SA
# dan role IAP/OS Login belum diberikan di luar Terraform.
my_iap_users = [
  "user:YOU@example.com",
  # "serviceAccount:OPERATOR_SA_EMAIL",
]

grant_os_admin_login = true
enable_apis          = true
nat_min_ports_per_vm = 256

# Sizing:
#   Profil Hari 1, 12 vCPU (contoh di bawah): core n2-standard-4, emu n2-standard-8,
#     enable_obs=false, enable_mpls=false. Pas dengan CPUS_ALL_REGIONS=12.
#   Minimal 3 VM: core n2-standard-4, emu n2-standard-4, obs e2-standard-2.
#   Optimal: core n2-standard-8, emu n2-standard-8, obs e2-standard-4.
# enable_mpls = true menambah e2-medium (2 vCPU) di subnet lab.
core_machine_type = "n2-standard-4"
emu_machine_type  = "n2-standard-8"
obs_machine_type  = "e2-standard-2"

# Profil 12 vCPU: tanpa vm-obs. Default variabel enable_obs tetap true.
enable_obs = false

# true = terraform destroy menghapus objek di bucket (skrip MPLS diunggah ke bucket).
bucket_force_destroy = true

# pd-balanced memakai kuota SSD_TOTAL_GB. Ganti ke pd-standard jika sisa kuota SSD tipis.
disk_type = "pd-balanced"

# Ukuran disk (GB). Minimal: 80 / 100 / 80. Optimal: 100 / 150 / 200.
core_disk_gb = 100
emu_disk_gb  = 150
obs_disk_gb  = 200

# Backhaul MPLS di VM terpisah (default off). e2-medium memakai 2 vCPU kuota;
# minimal 3-VM (10) + vm-mpls (2) = 12, pas dengan CPUS_ALL_REGIONS=12.
enable_mpls        = false
mpls_machine_type  = "e2-medium"
mpls_disk_gb       = 20
mpls_tunnel_mode   = "gre"   # atau "vxlan"
