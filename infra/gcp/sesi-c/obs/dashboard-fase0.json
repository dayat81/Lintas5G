  {
   "id": 1,
   "title": "Ping RTT UE->emu (ms): p50/p95/p99 per kondisi (Sesi B + C, semua ulangan)",
   "type": "barchart",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "ch"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "ch"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT concat(session,' ',cond) AS kondisi, round(quantileExact(0.5)(value_ms),1) AS p50, round(quantileExact(0.95)(value_ms),1) AS p95, round(quantileExact(0.99)(value_ms),1) AS p99 FROM poc_latency.probes WHERE ok=1 AND metric='ping_rtt' GROUP BY session, cond ORDER BY session, cond",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "showValue": "always",
    "stacking": "none",
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "xTickLabelRotation": 0,
    "barWidth": 0.85,
    "groupWidth": 0.8
   }
  },
