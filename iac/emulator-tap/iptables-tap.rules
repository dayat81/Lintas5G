-A FORWARD -i tap0 -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
-A INPUT ! -i lo -p tcp -m multiport --dports 5900,6080,5555,5554,9000 -j DROP
-A FORWARD -o tap0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -i tap0 -j ACCEPT
-A DOCKER-USER -o tap0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A DOCKER-USER -i tap0 -j ACCEPT
-A POSTROUTING -s 10.0.2.0/24 -o ens4 -j MASQUERADE
