# Salin ke tests/qod/.env (jangan di-commit). Semua nilai di bawah PLACEHOLDER.
PCF_URL=http://127.0.0.1:7777            # SBI PCF Open5GS (lihat pcf.yaml lab Anda)
SUPI=imsi-001010000000001                 # UE tes, PLMN tes 001/01 (DUMMY)
UE_IPV4=10.45.0.2                         # IP UE dari pool contoh Open5GS (ganti saat run)
DNN=internet
SNSSAI_SST=1
AF_APP_ID=lintas5g-qod-demo
APP_SERVER_IPV4=198.51.100.10             # server game/video tes (contoh RFC 5737)
APP_SERVER_PORT=443
NOTIF_URI=http://127.0.0.1:8080/notify    # callback AF (adapter qod-af)
# tc bottleneck
TC_DEV=ogstun                             # antarmuka N6/SGi (atau sisi backhaul, mis. pe2-ce)
TC_RATE=20mbit
TC_DELAY=10ms
# iperf3 latar
IPERF_SERVER=198.51.100.20
