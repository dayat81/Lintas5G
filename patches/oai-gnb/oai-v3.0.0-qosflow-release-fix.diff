   FOR_EACH_SEQ_ARR (drb_t *, drb, &UE->drbs) {
     if (drb->pdusession_id != dst->pdusession_id)
       continue;
@@ -1024,17 +1028,8 @@ static void nr_rrc_send_e1_after_qos_update(gNB_RRC_UE_t *UE,
