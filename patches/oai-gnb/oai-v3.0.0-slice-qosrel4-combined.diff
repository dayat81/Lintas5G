+/* ===================== Lintas5G: QoD-aware DL slice policy (eval) =====================
+ * Two-tier DL scheduler on top of the v3.0.0 pluggable pipeline:
+ *  tier 1: slice share. A UE belongs to the QoD slice if any of its DRBs carries a QoS flow
+ *          whose 5QI is in qod_5qi (or whose S-NSSAI SD == qod_sd). The QoD slice is served first
+ *          each slot with up to qod_max_pct of the PRBs (= guaranteed share when it has data);
+ *          the BE slice gets the remainder (work-conserving), optionally capped by be_max_pct.
+ *  tier 2: PF inside each slice (nr_dl_proportional_fair, unchanged).
+ *  intra-UE: nr_dl_lcid_alloc_pbr reserves pbr_pct of the TBS for SRBs/non-QoD DRBs so a
+ *          saturated QoD DRB cannot starve the default bearer.
+ * Config: file in env OAI_DL_SLICE_CONF, key=value lines, re-read when mtime changes (~every 1 s). */
+#include <sys/stat.h>
+#include <stdio.h>
+static struct {
+  int enabled, qod_max_pct, be_max_pct, pbr_pct, n5qi, qod_sd;
+  int q5qi[16];
+  time_t mtime;
+  uint64_t calls, rb_qod, rb_be, n_qod_slots;
+} slc = {.enabled = 0, .qod_max_pct = 70, .be_max_pct = 100, .pbr_pct = 20, .qod_sd = -1};
+
+static void slice_reload(void)
+{
+  const char *f = getenv("OAI_DL_SLICE_CONF");
+  struct stat st;
+  if (!f || stat(f, &st) != 0 || st.st_mtime == slc.mtime)
+    return;
+  FILE *fp = fopen(f, "r");
+  if (!fp)
+    return;
+  slc.mtime = st.st_mtime;
+  char line[256];
+  while (fgets(line, sizeof(line), fp)) {
+    char k[64], v[160];
+    if (line[0] == '#' || sscanf(line, " %63[^= ] = %159s", k, v) != 2)
+      continue;
+    if (!strcmp(k, "enabled")) slc.enabled = atoi(v);
+    else if (!strcmp(k, "qod_max_pct")) slc.qod_max_pct = atoi(v);
+    else if (!strcmp(k, "be_max_pct")) slc.be_max_pct = atoi(v);
+    else if (!strcmp(k, "pbr_pct")) slc.pbr_pct = atoi(v);
+    else if (!strcmp(k, "qod_sd")) slc.qod_sd = (int)strtol(v, NULL, 0);
+    else if (!strcmp(k, "qod_5qi")) {
+      slc.n5qi = 0;
+      for (char *t = strtok(v, ","); t && slc.n5qi < 16; t = strtok(NULL, ","))
+        slc.q5qi[slc.n5qi++] = atoi(t);
+    }
+  }
+  fclose(fp);
+  LOG_I(NR_MAC, "[SLICE] conf reloaded: enabled=%d qod_5qi_n=%d qod_sd=%d qod_max_pct=%d be_max_pct=%d pbr_pct=%d\n",
+        slc.enabled, slc.n5qi, slc.qod_sd, slc.qod_max_pct, slc.be_max_pct, slc.pbr_pct);
+}
+
+static bool lc_is_qod(const nr_lc_config_t *c)
+{
+  if (c->lcid < 4)
+    return false;
+  if (slc.qod_sd >= 0 && (int)c->nssai.sd == slc.qod_sd)
+    return true;
+  for (int q = 0; q < NR_MAX_NUM_QFI; q++)
+    for (int i = 0; i < slc.n5qi; i++)
+      if (c->qos_config[q].fiveQI > 0 && c->qos_config[q].fiveQI == slc.q5qi[i])
+        return true;
+  return false;
+}
+
+static bool ue_is_qod(const NR_UE_info_t *UE)
+{
+  const NR_UE_sched_ctrl_t *sc = &UE->UE_sched_ctrl;
+  for (int j = 0; j < seq_arr_size(&sc->lc_config); j++)
+    if (lc_is_qod(seq_arr_at(&sc->lc_config, j)))
+      return true;
+  return false;
+}
+
+static int slice_pass(const nr_dl_sched_params_t *params, nr_dl_candidate_t *c, int n, const bool *member, int rb_budget, int max_ue, int *rb_used)
+{
+  bool saved[MAX_MOBILES_PER_GNB];
+  int any = 0;
+  for (int i = 0; i < n; i++) {
+    saved[i] = c[i].skipped;
+    if (!member[i] || c[i].scheduled)
+      c[i].skipped = true;
+    any += !c[i].skipped;
+  }
+  int ns = 0;
+  *rb_used = 0;
+  if (any && rb_budget >= 5 && max_ue > 0) {
+    nr_dl_sched_params_t p = *params;
+    p.n_rb_avail[0] = rb_budget;
+    p.max_num_ue = max_ue;
+    ns = nr_dl_proportional_fair(&p, c, n);
+    for (int i = 0; i < n; i++)
+      if (member[i] && !c[i].skipped && c[i].scheduled)
+        *rb_used += c[i].sched_pdsch.rbSize;
+  }
+  for (int i = 0; i < n; i++)
+    c[i].skipped = saved[i];
+  return ns;
+}
+
+int nr_dl_slice_rb_alloc(const nr_dl_sched_params_t *params, nr_dl_candidate_t *c, int n)
+{
+  if ((slc.calls++ & 1023) == 0)
+    slice_reload();
+  if ((slc.calls & 0x3FFF) == 0 && slc.enabled) {
+    LOG_I(NR_MAC, "[SLICE] stats: qod_rbs=%lu be_rbs=%lu qod_slots=%lu qod_share=%.1f%%\n", slc.rb_qod, slc.rb_be, slc.n_qod_slots,
+          slc.rb_qod + slc.rb_be ? 100.0 * slc.rb_qod / (slc.rb_qod + slc.rb_be) : 0.0);
+    slc.rb_qod = slc.rb_be = slc.n_qod_slots = 0;
+  }
+  if (!slc.enabled || params->num_beams > 1)
+    return nr_dl_proportional_fair(params, c, n);
+  bool qod[MAX_MOBILES_PER_GNB], be[MAX_MOBILES_PER_GNB];
+  int nq = 0;
+  for (int i = 0; i < n; i++) {
+    qod[i] = ue_is_qod(c[i].UE) && !c[i].skipped;
+    be[i] = !qod[i];
+    nq += qod[i];
+  }
+  const int total = params->n_rb_avail[0];
+  int used_q = 0, used_b = 0, ns = 0;
+  if (nq) {
+    ns += slice_pass(params, c, n, qod, total * slc.qod_max_pct / 100, params->max_num_ue, &used_q);
+    slc.n_qod_slots++;
+  }
+  int be_budget = min(total - used_q, total * slc.be_max_pct / 100);
+  ns += slice_pass(params, c, n, be, be_budget, params->max_num_ue - ns, &used_b);
+  slc.rb_qod += used_q;
+  slc.rb_be += used_b;
+  return ns;
+}
+
+void nr_dl_lcid_alloc_pbr(const gNB_MAC_INST *mac, const nr_dl_candidate_t *cand, int tbs_available, int lcid_alloc[NR_MAX_NUM_LCID])
+{
+  nr_dl_lcid_alloc_default(mac, cand, tbs_available, lcid_alloc);
+  if (!slc.enabled || slc.pbr_pct <= 0)
+    return;
+  const NR_UE_sched_ctrl_t *sc = &cand->UE->UE_sched_ctrl;
+  int other = 0, qodb = 0;
+  for (int j = 0; j < seq_arr_size(&sc->lc_config); j++) {
+    const nr_lc_config_t *lc = seq_arr_at(&sc->lc_config, j);
+    if (lc_is_qod(lc))
+      qodb += lcid_alloc[lc->lcid];
+    else
+      other += lcid_alloc[lc->lcid];
+  }
+  if (qodb == 0 || other == 0)
+    return;
+  /* reserve min(other pending, pbr% of TBS) for SRBs/non-QoD DRBs; QoD DRBs get the rest */
+  int reserve = min(other, tbs_available * slc.pbr_pct / 100);
+  int qod_cap = max(tbs_available - reserve, 0);
+  for (int j = 0; j < seq_arr_size(&sc->lc_config); j++) {
+    const nr_lc_config_t *lc = seq_arr_at(&sc->lc_config, j);
+    if (lc_is_qod(lc)) {
+      int a = min(lcid_alloc[lc->lcid], qod_cap);
+      qod_cap -= a;
+      lcid_alloc[lc->lcid] = a > 0 ? a : 0;
+    }
+  }
+}
+
+/* E2 glue: called from the FlexRIC SLICE SM control handler (ran_func_slice.c). Overrides the file conf until the file changes. */
+void nr_dl_slice_e2_set(int enabled, int qod_max_pct)
+{
+  if (qod_max_pct > 0 && qod_max_pct <= 100)
+    slc.qod_max_pct = qod_max_pct;
+  slc.enabled = enabled;
+  if (slc.n5qi == 0) { slc.q5qi[0] = 7; slc.q5qi[1] = 1; slc.n5qi = 2; }
+  LOG_I(NR_MAC, "[SLICE] E2 control: enabled=%d qod_max_pct=%d\n", slc.enabled, slc.qod_max_pct);
+}
