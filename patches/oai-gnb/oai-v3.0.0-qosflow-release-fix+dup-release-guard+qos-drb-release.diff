index 7589603..66b9595 100644
--- a/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch.c
+++ b/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch.c
@@ -583,6 +583,10 @@ float dl_pf_weight(int mcs, int mcs_table, int nrOfLayers, float avg_throughput)
 {
   uint8_t Qm = nr_get_Qm_dl(mcs, mcs_table);
   uint16_t R = nr_get_code_rate_dl(mcs, mcs_table);
+  /* Lintas5G: a UE with no valid PDSCH config (nrOfLayers 0, e.g. while its bearers are released)
+   * gets weight 0 instead of a zero-input TBS computation */
+  if (nrOfLayers <= 0 || Qm == 0 || R == 0)
+    return 0.0f;
   uint32_t tbs = nr_compute_tbs(Qm, R, 1, 10, 0, 0, 0, nrOfLayers) >> 3;
   return (float)tbs / fmaxf(avg_throughput, 1e-9f);
 }
