# Salin ke .env (chmod 600). JANGAN commit .env. Semua nilai di bawah placeholder.

# --- ClickHouse / Grafana (observability/docker-compose.yml di vm-obs) ---
CLICKHOUSE_DB=poc_latency
CLICKHOUSE_USER=poc
CLICKHOUSE_PASSWORD=change-me
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# --- Vector agent (vm-core-ran) ---
ZEEK_LOG_DIR=/var/log/lab5g/zeek
OBS_VECTOR_ADDR=10.10.1.10:6000

# --- Adapter QoD (adapters/qod-af) ---
QOD_BACKEND=dry-run
QOD_PCF_URL=http://127.0.0.1:7777
QOD_API_TOKEN=change-me
QOD_NOTIF_URI=http://127.0.0.1:8080/notify

# --- GCP (dibaca oleh gcloud/terraform di mesin operator) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/aman/di/luar/repo/sa.json
# TF_VAR_project_id=YOUR_PROJECT_ID
